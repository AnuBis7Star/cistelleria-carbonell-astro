---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, text, align = 'center' } = Astro.props;
---

<div class:list={['section-heading', `section-heading--${align}`, 'reveal']}>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {text && <p>{text}</p>}
</div>
